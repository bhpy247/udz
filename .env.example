# ==============================================================================
# Udaipur Unfolded — Environment Variables Template
# ==============================================================================

# Backend Port & Environment
PORT=5001
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/udaipur_unfolded?schema=public"

# Admin Authentication Secret (Generate a strong 64-char key in production)
JWT_SECRET="udaipur_unfolded_jwt_secure_key_2026_super_secret"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origin
CORS_ORIGIN="http://localhost:3000"

# Public WhatsApp Click-to-Chat Phone (Digits only, including country code)
# Example: 919414000000 for India (+91 94140 XXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER="919414000000"

# Media Hosting (Cloudinary - Optional in MVP, recommended in production)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
